{
  "name": "fast-confetti",
  "version": "1.1.0",
  "description": "Customizable confetti effects for the web — cannon, fireworks, stars, snow, pride and more. TypeScript-first, built on canvas-confetti.",
  "author": "Can Cömertpay",
  "license": "MIT",
  "keywords": [
    "confetti",
    "canvas-confetti",
    "animation",
    "celebration",
    "fireworks",
    "particles",
    "effects",
    "typescript",
    "browser"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cancomertpay/fast-confetti.git"
  },
  "homepage": "https://github.com/cancomertpay/fast-confetti#readme",
  "bugs": {
    "url": "https://github.com/cancomertpay/fast-confetti/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "jest",
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.3"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.6.4",
    "@types/jest": "29.5.12",
    "@types/node": "^22.5.2",
    "jest": "29.7.0",
    "ts-jest": "29.2.4",
    "ts-node": "10.9.2",
    "tsup": "8.2.4",
    "typescript": "^5.5.4"
  }
}
